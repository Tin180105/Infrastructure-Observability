# Phiên bản image. CHƯA được docker pull thử: chạy "docker compose pull" để kiểm tra,
# nếu tag không tồn tại thì đổi sang tag có thật trên Docker Hub / gcr.io rồi ghim lại.
PROMETHEUS_VERSION=v2.55.1
NODE_EXPORTER_VERSION=v1.8.2
CADVISOR_VERSION=v0.49.1
BLACKBOX_VERSION=v0.25.0
ALERTMANAGER_VERSION=v0.27.0
GRAFANA_VERSION=11.3.0
NGINX_VERSION=1.27-alpine
UBUNTU_VERSION=24.04

# Chỉ dùng cho lab cục bộ (cổng chỉ mở ở 127.0.0.1). KHÔNG dùng credential sản xuất.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin-lab
